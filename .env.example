# Public URLs and public client keys ONLY. Copy to .env.local; never commit that file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase > Project Settings > API (your own independent IOJH 2.0 project)
# Both are public client configuration, NEVER a service_role / secret API key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# C05a does not use an admin/service-role key, database connection string,
# payment secret, or any Office ERP / SSB system credentials.

# Server-only HMAC signing secret, minimum 32 random characters.
# Required for recovery links; NEVER prefix with NEXT_PUBLIC_.
IOJH_AUTH_RECOVERY_SECRET=

# C06 server-only media Storage adapter. Set privately in .env.local; never NEXT_PUBLIC_.
# Use a dedicated IOJH 2.0 development project key, not another project.
IOJH_CMS_STORAGE_SERVICE_KEY=

# C07b notification service (not active until owner-configured C07c worker).
# The existing IOJH_JOBS_SERVICE_KEY is also used for backend-only notification RPCs.
# NEVER prefix any of these with NEXT_PUBLIC_.
IOJH_NOTIFICATIONS_SEND_ENABLED=false
IOJH_NOTIFICATIONS_RESEND_API_KEY=
IOJH_NOTIFICATIONS_FROM=
# Optional verified Resend event ingestion. Disabled until separately authorized.
IOJH_NOTIFICATIONS_WEBHOOK_ENABLED=false
IOJH_NOTIFICATIONS_WEBHOOK_SECRET=

# C07c runner: disabled until isolated staging is approved. 64 hex characters.
IOJH_JOBS_SERVICE_KEY=
IOJH_JOBS_RUNNER_ENABLED=false
IOJH_JOBS_RUNNER_SECRET=
# Staging-only explicit recipient. No live sends unless both flags and this address are set.
IOJH_NOTIFICATIONS_STAGING_RECIPIENT=
IOJH_NOTIFICATIONS_STAGING_NOTIFICATION_ID=
# Must exactly match NEXT_PUBLIC_SITE_URL origin; the live IOJH domain is denied.
IOJH_NOTIFICATIONS_STAGING_ORIGIN=
