# Public URLs and public client keys ONLY. Copy to .env.local; never commit that file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase > Project Settings > API (your own independent IOJH 2.0 project)
# Both are public client configuration, NEVER a service_role / secret API key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# C05a does not use an admin/service-role key, database connection string,
# payment secret, or any Office ERP / SSB system credentials.

# Server-only HMAC signing secret, minimum 32 random characters.
# Required for recovery links; NEVER prefix with NEXT_PUBLIC_.
IOJH_AUTH_RECOVERY_SECRET=
